# Jira Configuration
JIRA_URL=https://tele2.atlassian.net
JIRA_USERNAME=your-email@tele2.se
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=TELE2

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Nokia NSP
NOKIA_NSP_URL=https://nsp.tele2.se/api/v1
NOKIA_NSP_USERNAME=admin
NOKIA_NSP_PASSWORD=change-me

# TM Forum API
TMFORUM_URL=https://tmforum.tele2.se/tmf-api
TMFORUM_USERNAME=admin
TMFORUM_PASSWORD=change-me

# Tele2 Custom API
CUSTOM_API_URL=https://api.tele2.se/oss/v1
CUSTOM_API_KEY=your-custom-api-key

# Email (SMTP)
SMTP_HOST=smtp.tele2.se
SMTP_PORT=587
SMTP_USERNAME=notifications@tele2.se
SMTP_PASSWORD=change-me
EMAIL_FROM=auto-configurator@tele2.se

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change-me-to-a-random-string

# Polling interval in seconds
POLL_INTERVAL=30

# Dry run mode (true = propose only, false = execute)
DRY_RUN=true

# Log level
LOG_LEVEL=INFO
